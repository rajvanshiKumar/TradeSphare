# Optional. Leave both empty to run entirely on the built-in local catalogue (the default).
#
# TradeSphere ships with NO public API configured and never needs one.
# Only set these if you have a real, CORS-enabled public API that returns an array of
# products in the same shape as src/data/products.js (see src/services/apiClient.js and
# src/services/productService.js). If the API fails, the app falls back to local data.
#
# Variables starting with VITE_ are bundled into the public site: never put secrets here.
VITE_PUBLIC_API_BASE_URL=
VITE_PUBLIC_API_PRODUCTS_PATH=

# Admin sign-in (front-end prototype). Generate the value with `npm run admin:hash` and put it
# in .env.local, never in a committed file. The admin email is hello.techvunex@gmail.com.
# Leave empty to disable admin sign-in.
VITE_ADMIN_PASSWORD_HASH=
